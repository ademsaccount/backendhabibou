# ---- Serveur ----
PORT=4000
CORS_ORIGIN=*

# ---- Supabase (Postgres) ----
# Format : postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Percent-encode le mot de passe s'il contient des caractères speciques (% -> %25, @ -> %40, # -> %23...)
DATABASE_URL=

# ---- Supabase Storage (photos restaurants / produits / demandes libres) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=habichou

# ---- Auth JWT ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Connexion Google (ID token natif) ----
# Web client ID Google : OBLIGATOIRE (audience principale du backend).
# Ne jamais mettre le client secret ici : il n'est pas utilise.
GOOGLE_CLIENT_ID=
# Audiences supplementaires acceptees (optionnelles).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- Livraison ----
# Frais = fixe + 0.5/km (ligne droite, arrondi au km superieur de chaque troncon)
# + supplement par commerce supplementaire dans la meme commande.
DELIVERY_BASE_FEE=2
DELIVERY_PER_KM_FEE=0.5
DELIVERY_HOP_FEE=0.5

# ---- Horaires ----
# Fuseau horaire utilise pour comparer opening_hours (HH:MM) a l'heure courante
BUSINESS_TZ=Africa/Tunis

# ---- Stripe (mode test, optionnel : si absent, le paiement carte est simule) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
