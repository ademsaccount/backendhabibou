# ---- Serveur ----
PORT=4000
CORS_ORIGIN=*

# ---- Supabase (Postgres) ----
# Format : postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Percent-encode le mot de passe s'il contient des caractères speciques (% -> %25, @ -> %40, # -> %23...)
DATABASE_URL=

# ---- Supabase Storage (photos restaurants / produits / demandes libres) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=habichou
# Bucket public des medias de categories (GIF specialites, ecran Restaurants).
# A creer une fois dans Supabase (Dashboard -> Storage -> New bucket):
#   name: category-media  |  Public bucket: ON  (voir README)
SUPABASE_MEDIA_BUCKET=category-media

# ---- Auth JWT ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Connexion Google (ID token natif) ----
# Web client ID Google : OBLIGATOIRE (audience principale du backend).
# Ne jamais mettre le client secret ici : il n'est pas utilise.
GOOGLE_CLIENT_ID=
# Audiences supplementaires acceptees (optionnelles).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- Sign in with Apple (iOS uniquement) ----
# Bundle identifier de l'app : audience du jeton d'identite ET client_id.
APPLE_BUNDLE_ID=com.adem1.habichou
# Team ID (Dashboard Apple > Membership), Identifiant de cle (Key ID) et cle
# .p8 (Accounts > Keys > Generate). Les retours a la ligne de la cle doivent
# etre ecrits comme "\n" litteraux dans le .env (sinon jwt refuse la cle).
# Necessaire pour echanger le code et revoquer le refresh token ; sans eux la
# connexion Apple fonctionne quand meme (aucun refresh token ne sera stocke).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Email Mailjet (mot de passe oublie) ----
# API HTTP Mailjet Send v3.1 : SMTP est inutilisable (Render bloque les ports 25/465/587).
# Optionnel en developpement : sans configuration, le code est loggue et renvoye
# dans `dev_code`. En production, les quatre variables MAILJET_* sont requises.
# Cles API : https://app.mailjet.com/account/api_keys (jamais en clair ici).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Expediteur verifie dans Mailjet (Sender domains), ex. "no-reply@habichou.tn"
MAILJET_SENDER_EMAIL=
# Nom affiche de l'expediteur, ex. "Habichou"
MAILJET_SENDER_NAME=
# Duree de vie du code (minutes) et nombre d'essais autorises.
PASSWORD_RESET_TTL_MIN=15
PASSWORD_RESET_MAX_ATTEMPTS=5
# Idem pour le code de verification d'email a l'inscription.
EMAIL_VERIFICATION_TTL_MIN=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ---- Livraison ----
# Frais = fixe + 0.5/km (ligne droite, arrondi au km superieur de chaque troncon)
# + supplement par commerce supplementaire dans la meme commande.
DELIVERY_BASE_FEE=2
DELIVERY_PER_KM_FEE=0.5
DELIVERY_HOP_FEE=0.5

# ---- Horaires ----
# Fuseau horaire utilise pour comparer opening_hours (HH:MM) a l'heure courante
BUSINESS_TZ=Africa/Tunis

# ---- Stripe (mode test, optionnel : si absent, le paiement carte est simule) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
