# ---- Serveur ----
PORT=4000
CORS_ORIGIN=*

# ---- Supabase (Postgres) ----
# Format : postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Percent-encode le mot de passe s'il contient des caractères speciques (% -> %25, @ -> %40, # -> %23...)
DATABASE_URL=

# ---- Supabase Storage (photos restaurants / produits / demandes libres) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=habichou

# ---- Auth JWT ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Livraison ----
DELIVERY_FEE=15
NEARBY_RADIUS_KM=20

# ---- Stripe (mode test, optionnel : si absent, le paiement carte est simule) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
