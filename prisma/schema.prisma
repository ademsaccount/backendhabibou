// Prisma schema â€” Habichou
// Toutes les colonnes en snake_case (contrat JSON = snake_case cÃ´tÃ© REST).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  admin
  livreur
}

enum CommerceCategory {
  restaurant
  snack
  epicerie
  pharmacie
  tabac
}

enum CustomRequestStatus {
  pending
  quoted
  accepted
  rejected
}

enum OrderStatus {
  pending
  confirmed
  preparing
  picked_up
  on_the_way
  delivered
  cancelled
}

/** Etat temps reel d'UN commerce dans le pipeline branché d'une commande multi-commerces. */
enum OrderShopStatusValue {
  preparing
  picked_up
}

enum PaymentMethod {
  card
  cash
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PriceStatus {
  none
  proposed
  approved
  rejected
}

enum StoryMedia {
  image
  video
}

/** Origine du compte : mot de passe local ou connexion Google. */
enum CouponStatus {
  AVAILABLE
  USED
}

enum CouponType {
  FREE_DELIVERY
}

enum CouponSource {
  WELCOME
}

enum AuthProvider {
  local
  google
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?
  password_hash String?
  full_name     String
  role          Role     @default(client)
  avatar_url    String?
  // Identifiant Google stable (payload.sub du jeton ID) — unique par compte.
  google_id     String?  @unique
  auth_provider AuthProvider @default(local)
  // Jeton Expo Push (app sudo_habichou) â€” null = notifications push non enregistrees.
  expo_push_token String?
  // Locale du client pour localiser les pushes (fr | en | aeb).
  locale          String?
  // Date de verification de l'email a l'inscription (null = non verifie :
  // aucun token n'est alors emis). Les comptes existants sont grandfatheres
  // par la migration (verifies) pour ne bloquer personne.
  email_verified_at DateTime?
  created_at    DateTime @default(now())

  addresses     Address[]
  orders        Order[]
  custom_requests CustomRequest[]
  notifications Notification[]
  reviews       Review[]
  livreur       Livreur?
  cart          Cart?
  refresh_tokens RefreshToken[]
  password_reset_codes PasswordResetCode[]
  email_verification_codes EmailVerificationCode[]
  restaurants_created Restaurant[] @relation("RestaurantCreatedBy")
  saved_carts     SavedCart[]
  coupons         Coupon[]

  @@index([role])
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/**
 * Code de reinitialisation de mot de passe (6 chiffres, envoye par email).
 * Seul le hash du code est stocke ; un seul code actif par utilisateur.
 */
model PasswordResetCode {
  id         String   @id @default(uuid())
  user_id    String
  code_hash  String
  expires_at DateTime
  attempts   Int      @default(0)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/**
 * Code de verification d'email a l'inscription (6 chiffres, envoye par email).
 * Seul le hash du code est stocke ; un seul code actif par utilisateur ;
 * consumed_at rend le code unique (usage unique apres validation).
 */
model EmailVerificationCode {
  id          String    @id @default(uuid())
  user_id     String
  code_hash   String
  expires_at  DateTime
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())
  // Renseigne quand le code a ete valide : un code consomme ne peut plus servir.
  consumed_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  label        String
  address_type String   @default("other")
  latitude     Float
  longitude    Float
  address_text String
  /** Rue la plus proche, resolue automatiquement depuis la carte (jamais saisie par l'utilisateur). */
  street_name  String?
  /** Bloc complet du geocodage inverse (Nominatim) : display_name + objet
   *  address brut, cles conservees telles quelles (country, county, postcode,
   *  state, state_district, road, house_number… quand presentes). */
  geocode      Json?
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders          Order[]
  custom_requests CustomRequest[]

  @@index([user_id])
  @@index([latitude, longitude])
}

model Restaurant {
  id                  String           @id @default(uuid())
  name                String
  category            CommerceCategory
  description         String?
  logo_url            String?
  cover_url           String?
  address             String
  latitude            Float
  longitude           Float
  is_open             Boolean          @default(true)
  rating              Float            @default(0)
  opening_hours       Json?
  /** Fermeture exceptionnelle : le commerce reste ferme jusqu'a cette date/heure (revert automatique). */
  temp_closed_until   DateTime?
  created_by_admin_id String?
  created_at          DateTime         @default(now())

  products  Product[]
  orders    Order[]
  reviews   Review[]
  stories   Story[]
  // Garnitures au niveau du commerce (cochees une fois, appliquees automatiquement
  // aux produits selon de leur dish_type — voir src/lib/categoryRules.ts).
  restaurant_supplements RestaurantSupplement[]
  restaurant_sauces      RestaurantSauce[]
  restaurant_salads      RestaurantSalad[]
  creator   User?      @relation("RestaurantCreatedBy", fields: [created_by_admin_id], references: [id])

  @@index([latitude, longitude])
  @@index([category])
  @@index([is_open])
}

model Product {
  id                    String   @id @default(uuid())
  restaurant_id         String
  name                  String
  description           String?
  price                 Float
  image_url             String?
  category              String   @default("Divers")
  // Type de plat transverse a tous les restaurants (Makloub, Pizza, Fricasse...)
  // -> filtre "Par type de plat" du flux Repas. Valeur libre saisie par l'admin.
  dish_type             String?
  // Variante du plat ("Margherita" pour une Pizza, "Thon" pour un Makloub…).
  flavor                String?
  // Tailles multiples (2+ : Medium/Large/...) : [{ label, price }].
  // Des que 2 tailles ou plus, price = min des tailles ("a partir de X").
  sizes                 Json?
  // Lien vers la categorie de medicament (flux Pharmacie) â€” null hors pharmacie.
  medication_category_id String?
  is_available          Boolean  @default(true)
  options               Json?
  created_at            DateTime @default(now())

  restaurant         Restaurant               @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  medication_category MedicationCategory?     @relation(fields: [medication_category_id], references: [id], onDelete: SetNull)
  order_items        OrderItem[]
  cart_items         CartItem[]
  ingredients        ProductIngredient[]
  supplements        ProductSupplement[]

  @@index([restaurant_id])
  @@index([restaurant_id, is_available])
  @@index([dish_type])
  @@index([medication_category_id])
}

// Catalogue global d'ingredients (reutilisable d'un produit a l'autre).
// Relation produit <-> ingredient : liste informative affichee sur l'ecran produit client.
model Ingredient {
  id                String   @id @default(uuid())
  name              String   @unique
  // false = ingredient "local" (saisi pour un seul produit, absent du selecteur).
  in_catalog        Boolean  @default(true)
  created_by_admin  String?
  created_at        DateTime @default(now())

  products ProductIngredient[]
}

model ProductIngredient {
  product_id    String
  ingredient_id String
  sort_order    Int     @default(0)

  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([product_id, ingredient_id])
  @@index([ingredient_id])
}

// Catalogue global de supplements (ajouts optionnels payants coches par le client).
model Supplement {
  id                  String   @id @default(uuid())
  name                String   @unique
  // Prix propose par defaut ; ProductSupplement.extra_price_override peut le surcharger.
  default_extra_price Float    @default(0)
  // false = supplement "local" (saisi pour un seul produit, absent du selecteur).
  in_catalog          Boolean  @default(true)
  created_by_admin    String?
  image_url           String?
  created_at          DateTime @default(now())

  products    ProductSupplement[]
  // Commerces qui ont coche ce supplement dans leurs garnitures shop.
  restaurants RestaurantSupplement[]
}

model ProductSupplement {
  product_id           String
  supplement_id        String
  // null = utiliser Supplement.default_extra_price.
  extra_price_override Float?
  sort_order           Int      @default(0)

  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplement_id], references: [id], onDelete: Cascade)

  @@id([product_id, supplement_id])
  @@index([supplement_id])
}

// Supplement au niveau du commerce : LIAISON entre un commerce et le
// catalogue global Supplement (garniture coquee une fois pour tout le shop) :
// applique automatiquement aux produits selon leur dish_type via src/lib/categoryRules.ts.
// Sans relation produit : il complete (ou coexiste avec) ProductSupplement.
model RestaurantSupplement {
  restaurant_id String
  supplement_id String
  // Prix de l'ajout (DT) pour CE commerce — 0.5 par defaut (le catalogue garde
  // Supplement.default_extra_price comme proposition).
  extra_price   Float   @default(0.5)
  // true = aussi applique aux Fricasses (les sauces ne le sont JAMAIS).
  for_fricasse  Boolean @default(false)
  sort_order    Int     @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplement_id], references: [id], onDelete: Cascade)

  @@id([restaurant_id, supplement_id])
  @@index([supplement_id])
}

// Sauce au niveau du commerce : gratuite, appliquee automatiquement (jamais aux
// Fricasses) et jamais tarifée comme un supplement. Le catalogue global Sauce
// porte le nom (+ image) ; la table ci-dessous ne fait que la LIER au commerce.
model RestaurantSauce {
  restaurant_id String
  sauce_id      String
  sort_order    Int     @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  sauce      Sauce      @relation(fields: [sauce_id], references: [id], onDelete: Cascade)

  @@id([restaurant_id, sauce_id])
  @@index([sauce_id])
}

// Salade au niveau du commerce (garnitures fraîches : laitue, tomate, oignon,
// concombre…) : GRATUITE, jamais tarifée, appliquée automatiquement seulement aux
// Sandwich, Burger, Makloub, Libanais et Baguette farcie (jamais Fricassé/Tacos/Cornet).
// LIAISON vers le catalogue global Salad (nom + image).
model RestaurantSalad {
  restaurant_id String
  salad_id      String
  sort_order    Int     @default(0)

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  salad      Salad      @relation(fields: [salad_id], references: [id], onDelete: Cascade)

  @@id([restaurant_id, salad_id])
  @@index([salad_id])
}

// Catalogue GLOBAL de sauces du commerce : une ligne par nom normalise
// (name_key) partagee par tous les commerces, avec une image optionnelle.
// Gratuites, jamais tarifées.
model Sauce {
  id         String   @id @default(uuid())
  name       String
  // Cle de dedup : minuscules, accents supprimes, trim + espaces internes réduits.
  name_key   String   @unique
  image_url  String?
  created_at DateTime @default(now())

  restaurants RestaurantSauce[]
}

// Catalogue GLOBAL de salades du commerce : une ligne par nom normalise,
// image optionnelle. Gratuites, jamais tarifées.
model Salad {
  id         String   @id @default(uuid())
  name       String
  name_key   String   @unique
  image_url  String?
  created_at DateTime @default(now())

  restaurants RestaurantSalad[]
}

// Categories de medicaments du flux Pharmacie â€” table configurable cote admin (pas en dur).
model MedicationCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  products Product[]

  @@index([is_active, sort_order])
}

model CustomRequest {
  id                String              @id @default(uuid())
  user_id           String
  description_text  String
  photo_url         String?
  estimated_budget  Float?
  status            CustomRequestStatus @default(pending)
  admin_quote_price Float?
  address_id        String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  address Address @relation(fields: [address_id], references: [id])
  order   Order?

  @@index([status])
  @@index([user_id])
}

model Cart {
  id         String   @id @default(uuid())
  user_id    String   @unique
  updated_at DateTime @updatedAt

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id         String  @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int     @default(1)
  notes      String?
  options    Json?
  // Taille choisie (remplace le prix de base, distinct des supplÃ©ments).
  size_label String?

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, product_id])
  @@index([cart_id])
}

/**
 * Coupon (bienvenue) : un seul par utilisateur et par source (WELCOME),
 * accorde a la verification du compte. Jamais recupere (pas de backfill).
 * Lien vers la commande utilisee via Order.coupon_id (unique) ; order_id ici
 * est un simple miroir pour lecture admin/annulation sans jointure inverse.
 */
model Coupon {
  id           String       @id @default(uuid())
  user_id      String
  type         CouponType   @default(FREE_DELIVERY)
  source       CouponSource
  status       CouponStatus @default(AVAILABLE)
  /** Date d'utilisation (positionee lors du claim atomique). */
  used_at      DateTime?
  /** Commande qui a consomme le coupon (miroir de Order.coupon_id). */
  order_id     String?
  /** Vu dans le modal / liste coupons (idempotent). */
  seen_at      DateTime?
  /** Push bienvenue envoye (null = pas encore ; envoi differe si pas de token). */
  welcome_notified_at DateTime?
  created_at   DateTime     @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /** Cote "back" de Order.coupon (FK = Order.coupon_id). */
  order Order?

  @@unique([user_id, source])
  @@index([user_id, status])
  @@index([user_id])
}

model Order {
  id                String        @id @default(uuid())
  user_id           String
  restaurant_id     String?
  custom_request_id String?       @unique
  livreur_id        String?
  status            OrderStatus   @default(pending)
  total_price       Float
  delivery_fee      Float         @default(15)
  payment_method    PaymentMethod @default(cash)
  payment_status    PaymentStatus @default(pending)
  payment_intent_id String?
  /** Prix proposÃ© par le livreur (nÃ©go demande spÃ©cifique) ; total = prix + livraison Ã  l'approbation. */
  proposed_price    Float?
  price_status      PriceStatus @default(none)
  /** Diffusion d'appel : snapshot des livreurs dÃ©marchÃ©s + refus (tous refusent = annulation). */
  diffused_at       DateTime?
  /** File d'attente : posÃ©e quand l'admin est occupÃ© et aucun livreur libre ; vide aprÃ¨s diffusion. */
  queued_at         DateTime?
  diffused_to       String[]  @default([])
  rejected_by       String[]  @default([])
  address_id        String
  /** Coupon de bienvenue applique (null = aucun). Unique : un coupon = une commande. */
  coupon_id         String?       @unique
  /** Montant de frais de livraison rembourse par le coupon (0 = aucun remboursement). */
  delivery_discount Float         @default(0)
  created_at        DateTime      @default(now())
  delivered_at      DateTime?

  user           User           @relation(fields: [user_id], references: [id])
  restaurant     Restaurant?    @relation(fields: [restaurant_id], references: [id])
  custom_request CustomRequest? @relation(fields: [custom_request_id], references: [id])
  livreur        Livreur?       @relation(fields: [livreur_id], references: [id])
  address        Address        @relation(fields: [address_id], references: [id])
  coupon         Coupon?        @relation(fields: [coupon_id], references: [id])
  items          OrderItem[]
  messages       OrderMessage[]
  review         Review?
  /** Etat de chaque branche (commerce) dans le pipeline : tap du livreur par commerce. */
  shop_statuses  OrderShopStatus[]

  @@index([status])
  @@index([user_id])
  @@index([livreur_id, status])
  @@index([restaurant_id])
  @@index([created_at])
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  unit_price Float
  notes      String?
  options    Json?
  // Taille choisie (remplace le prix de base, distinct des supplÃ©ments).
  size_label String?

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
}

/** Branche du pipeline : etat d'UN commerce d'une commande (tap livreur avisé). */
model OrderShopStatus {
  id            String             @id @default(uuid())
  order_id      String
  restaurant_id String
  status        OrderShopStatusValue @default(preparing)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, restaurant_id])
  @@index([order_id])
}

/** Message de nÃ©gociation d'une commande (texte libre ou proposition de prix). */
model OrderMessage {
  id          String   @id @default(uuid())
  order_id    String
  sender_id   String
  /** 'client' | 'admin'. */
  sender_role String
  /** 'text' | 'price'. */
  kind        String
  text        String?
  price       Float?
  created_at  DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
}

model Livreur {
  id           String   @id @default(uuid())
  user_id      String   @unique
  vehicle_type String   @default("moto")
  current_lat  Float?
  current_lng  Float?
  is_online    Boolean  @default(false)
  rating       Float    @default(0)
  created_at   DateTime @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([is_online])
  @@index([current_lat, current_lng])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  body       String
  type       String   @default("info")
  data       Json?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}

model Review {
  id            String   @id @default(uuid())
  order_id      String   @unique
  user_id       String
  restaurant_id String?
  rating        Int
  comment       String?
  created_at    DateTime @default(now())

  order      Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id])
  @@index([user_id])
}

/** Story d'offre d'un commerce (style Instagram) : image ou vidÃ©o + texte optionnel. */
model Story {
  id                  String     @id @default(uuid())
  restaurant_id       String
  media_url           String
  media_type          StoryMedia
  /** LÃ©gende affichÃ©e sur le mÃ©dia (emojis inclus). */
  text                String?
  /** Couleur du texte (hex #RRGGBB), null = blanc. */
  text_color          String?
  /** Position du texte en fractions d'Ã©cran centrÃ©es (-0.5..0.5), null = bas centrÃ©. */
  text_x              Float?
  text_y              Float?
  /** Ã‰chelle du texte (0.5..3), null = 1. */
  text_scale          Float?
  /** Fin de diffusion (null = sans limite). */
  expires_at          DateTime?
  is_active           Boolean    @default(true)
  created_by_admin_id String?
  created_at          DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([expires_at])
}

// Panier sauvegarde par le client (menus "Saved carts" du profil) : snapshot
// JSON des lignes du panier au moment de la sauvegarde. Les prix affiches
// (price) sont informatifs : le serveur recalcule TOUT au moment de la
// commande, comme pour un panier classique (voir order.routes.ts).
model SavedCart {
  id         String   @id @default(uuid())
  user_id    String
  // Libelle (30 max ; vide -> "untitled").
  name       String   @default("untitled")
  // Snapshot des lignes : [{ product_id, quantity, size_label?, options?, notes? }].
  items      Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// Bibliotheque de medias (GIF de categories) : fichiers convertis en WebP
// anime et stockes sur Supabase Storage (jamais sur le disque Render).
// `version` = hash SHA-256 du contenu (nom de fichier immutable <hash>.webp).
model MediaAsset {
  id           String   @id @default(uuid())
  name         String
  storage_path String   @unique
  public_url   String
  mime_type    String   @default("image/webp")
  width        Int?
  height       Int?
  size_bytes   Int
  version      String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  categories Category[]

  @@index([created_at])
}

// Categorie d'etablissement / specialite du client (ecran Restaurants) :
// cle stable `slug` identique aux identifiants historiques de l'app
// (fast_food, burger, pizza, plats) pour rester compatible avec les
// versions installees qui lisent encore leurs GIFs locales.
model Category {
  id             String      @id @default(uuid())
  slug           String      @unique
  name_fr        String
  name_en        String
  name_aeb       String
  position       Int         @default(0)
  is_active      Boolean     @default(true)
  media_asset_id String?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  media MediaAsset? @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)

  @@index([is_active, position])
}
