// Prisma schema â€” Habichou
// Toutes les colonnes en snake_case (contrat JSON = snake_case cÃ´tÃ© REST).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  admin
  livreur
}

enum CommerceCategory {
  restaurant
  snack
  epicerie
  pharmacie
  tabac
}

enum CustomRequestStatus {
  pending
  quoted
  accepted
  rejected
}

enum OrderStatus {
  pending
  confirmed
  preparing
  picked_up
  on_the_way
  delivered
  cancelled
}

/** Etat temps reel d'UN commerce dans le pipeline branché d'une commande multi-commerces. */
enum OrderShopStatusValue {
  preparing
  picked_up
}

enum PaymentMethod {
  card
  cash
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PriceStatus {
  none
  proposed
  approved
  rejected
}

enum StoryMedia {
  image
  video
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?
  password_hash String
  full_name     String
  role          Role     @default(client)
  avatar_url    String?
  // Jeton Expo Push (app sudo_habichou) â€” null = notifications push non enregistrees.
  expo_push_token String?
  // Locale du client pour localiser les pushes (fr | en | aeb).
  locale          String?
  created_at    DateTime @default(now())

  addresses     Address[]
  orders        Order[]
  custom_requests CustomRequest[]
  notifications Notification[]
  reviews       Review[]
  livreur       Livreur?
  cart          Cart?
  refresh_tokens RefreshToken[]
  restaurants_created Restaurant[] @relation("RestaurantCreatedBy")

  @@index([role])
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  label        String
  address_type String   @default("other")
  latitude     Float
  longitude    Float
  address_text String
  /** Rue la plus proche, resolue automatiquement depuis la carte (jamais saisie par l'utilisateur). */
  street_name  String?
  /** Bloc complet du geocodage inverse (Nominatim) : display_name + objet
   *  address brut, cles conservees telles quelles (country, county, postcode,
   *  state, state_district, road, house_number… quand presentes). */
  geocode      Json?
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders          Order[]
  custom_requests CustomRequest[]

  @@index([user_id])
  @@index([latitude, longitude])
}

model Restaurant {
  id                  String           @id @default(uuid())
  name                String
  category            CommerceCategory
  description         String?
  logo_url            String?
  cover_url           String?
  address             String
  latitude            Float
  longitude           Float
  is_open             Boolean          @default(true)
  rating              Float            @default(0)
  opening_hours       Json?
  /** Fermeture exceptionnelle : le commerce reste ferme jusqu'a cette date/heure (revert automatique). */
  temp_closed_until   DateTime?
  created_by_admin_id String?
  created_at          DateTime         @default(now())

  products  Product[]
  orders    Order[]
  reviews   Review[]
  stories   Story[]
  // Garnitures au niveau du commerce (cochees une fois, appliquees automatiquement
  // aux produits selon de leur dish_type — voir src/lib/categoryRules.ts).
  restaurant_supplements RestaurantSupplement[]
  restaurant_sauces      RestaurantSauce[]
  creator   User?      @relation("RestaurantCreatedBy", fields: [created_by_admin_id], references: [id])

  @@index([latitude, longitude])
  @@index([category])
  @@index([is_open])
}

model Product {
  id                    String   @id @default(uuid())
  restaurant_id         String
  name                  String
  description           String?
  price                 Float
  image_url             String?
  category              String   @default("Divers")
  // Type de plat transverse a tous les restaurants (Makloub, Pizza, Fricasse...)
  // -> filtre "Par type de plat" du flux Repas. Valeur libre saisie par l'admin.
  dish_type             String?
  // Variante du plat ("Margherita" pour une Pizza, "Thon" pour un Makloub…).
  flavor                String?
  // Tailles multiples (2+ : Medium/Large/...) : [{ label, price }].
  // Des que 2 tailles ou plus, price = min des tailles ("a partir de X").
  sizes                 Json?
  // Lien vers la categorie de medicament (flux Pharmacie) â€” null hors pharmacie.
  medication_category_id String?
  is_available          Boolean  @default(true)
  options               Json?
  created_at            DateTime @default(now())

  restaurant         Restaurant               @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  medication_category MedicationCategory?     @relation(fields: [medication_category_id], references: [id], onDelete: SetNull)
  order_items        OrderItem[]
  cart_items         CartItem[]
  ingredients        ProductIngredient[]
  supplements        ProductSupplement[]

  @@index([restaurant_id])
  @@index([restaurant_id, is_available])
  @@index([dish_type])
  @@index([medication_category_id])
}

// Catalogue global d'ingredients (reutilisable d'un produit a l'autre).
// Relation produit <-> ingredient : liste informative affichee sur l'ecran produit client.
model Ingredient {
  id                String   @id @default(uuid())
  name              String   @unique
  // false = ingredient "local" (saisi pour un seul produit, absent du selecteur).
  in_catalog        Boolean  @default(true)
  created_by_admin  String?
  created_at        DateTime @default(now())

  products ProductIngredient[]
}

model ProductIngredient {
  product_id    String
  ingredient_id String
  sort_order    Int     @default(0)

  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([product_id, ingredient_id])
  @@index([ingredient_id])
}

// Catalogue global de supplements (ajouts optionnels payants coches par le client).
model Supplement {
  id                  String   @id @default(uuid())
  name                String   @unique
  // Prix propose par defaut ; ProductSupplement.extra_price_override peut le surcharger.
  default_extra_price Float    @default(0)
  // false = supplement "local" (saisi pour un seul produit, absent du selecteur).
  in_catalog          Boolean  @default(true)
  created_by_admin    String?
  created_at          DateTime @default(now())

  products ProductSupplement[]
}

model ProductSupplement {
  product_id           String
  supplement_id        String
  // null = utiliser Supplement.default_extra_price.
  extra_price_override Float?
  sort_order           Int      @default(0)

  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplement Supplement @relation(fields: [supplement_id], references: [id], onDelete: Cascade)

  @@id([product_id, supplement_id])
  @@index([supplement_id])
}

// Supplement au niveau du commerce (garniture cochee une fois pour tout le shop) :
// applique automatiquement aux produits selon leur dish_type via src/lib/categoryRules.ts.
// Sans relation produit : il complete (ou coexiste avec) ProductSupplement.
model RestaurantSupplement {
  id            String  @id @default(uuid())
  restaurant_id String
  name          String
  // Prix de l'ajout (DT) — 0.5 par defaut.
  extra_price   Float   @default(0.5)
  // true = aussi applique aux Fricasses (les sauces ne le sont JAMAIS).
  for_fricasse  Boolean @default(false)
  sort_order    Int     @default(0)
  created_at    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, name])
  @@index([restaurant_id])
}

// Sauce au niveau du commerce : gratuite, appliquee automatiquement (jamais aux
// Fricasses) et jamais tarifée comme un supplement.
model RestaurantSauce {
  id            String  @id @default(uuid())
  restaurant_id String
  name          String
  sort_order    Int     @default(0)
  created_at    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, name])
  @@index([restaurant_id])
}

// Categories de medicaments du flux Pharmacie â€” table configurable cote admin (pas en dur).
model MedicationCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  products Product[]

  @@index([is_active, sort_order])
}

model CustomRequest {
  id                String              @id @default(uuid())
  user_id           String
  description_text  String
  photo_url         String?
  estimated_budget  Float?
  status            CustomRequestStatus @default(pending)
  admin_quote_price Float?
  address_id        String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  address Address @relation(fields: [address_id], references: [id])
  order   Order?

  @@index([status])
  @@index([user_id])
}

model Cart {
  id         String   @id @default(uuid())
  user_id    String   @unique
  updated_at DateTime @updatedAt

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id         String  @id @default(uuid())
  cart_id    String
  product_id String
  quantity   Int     @default(1)
  notes      String?
  options    Json?
  // Taille choisie (remplace le prix de base, distinct des supplÃ©ments).
  size_label String?

  cart    Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, product_id])
  @@index([cart_id])
}

model Order {
  id                String        @id @default(uuid())
  user_id           String
  restaurant_id     String?
  custom_request_id String?       @unique
  livreur_id        String?
  status            OrderStatus   @default(pending)
  total_price       Float
  delivery_fee      Float         @default(15)
  payment_method    PaymentMethod @default(cash)
  payment_status    PaymentStatus @default(pending)
  payment_intent_id String?
  /** Prix proposÃ© par le livreur (nÃ©go demande spÃ©cifique) ; total = prix + livraison Ã  l'approbation. */
  proposed_price    Float?
  price_status      PriceStatus @default(none)
  /** Diffusion d'appel : snapshot des livreurs dÃ©marchÃ©s + refus (tous refusent = annulation). */
  diffused_at       DateTime?
  /** File d'attente : posÃ©e quand l'admin est occupÃ© et aucun livreur libre ; vide aprÃ¨s diffusion. */
  queued_at         DateTime?
  diffused_to       String[]  @default([])
  rejected_by       String[]  @default([])
  address_id        String
  created_at        DateTime      @default(now())
  delivered_at      DateTime?

  user           User           @relation(fields: [user_id], references: [id])
  restaurant     Restaurant?    @relation(fields: [restaurant_id], references: [id])
  custom_request CustomRequest? @relation(fields: [custom_request_id], references: [id])
  livreur        Livreur?       @relation(fields: [livreur_id], references: [id])
  address        Address        @relation(fields: [address_id], references: [id])
  items          OrderItem[]
  messages       OrderMessage[]
  review         Review?
  /** Etat de chaque branche (commerce) dans le pipeline : tap du livreur par commerce. */
  shop_statuses  OrderShopStatus[]

  @@index([status])
  @@index([user_id])
  @@index([livreur_id, status])
  @@index([restaurant_id])
  @@index([created_at])
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  unit_price Float
  notes      String?
  options    Json?
  // Taille choisie (remplace le prix de base, distinct des supplÃ©ments).
  size_label String?

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
}

/** Branche du pipeline : etat d'UN commerce d'une commande (tap livreur avisé). */
model OrderShopStatus {
  id            String             @id @default(uuid())
  order_id      String
  restaurant_id String
  status        OrderShopStatusValue @default(preparing)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, restaurant_id])
  @@index([order_id])
}

/** Message de nÃ©gociation d'une commande (texte libre ou proposition de prix). */
model OrderMessage {
  id          String   @id @default(uuid())
  order_id    String
  sender_id   String
  /** 'client' | 'admin'. */
  sender_role String
  /** 'text' | 'price'. */
  kind        String
  text        String?
  price       Float?
  created_at  DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id, created_at])
}

model Livreur {
  id           String   @id @default(uuid())
  user_id      String   @unique
  vehicle_type String   @default("moto")
  current_lat  Float?
  current_lng  Float?
  is_online    Boolean  @default(false)
  rating       Float    @default(0)
  created_at   DateTime @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([is_online])
  @@index([current_lat, current_lng])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  body       String
  type       String   @default("info")
  data       Json?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}

model Review {
  id            String   @id @default(uuid())
  order_id      String   @unique
  user_id       String
  restaurant_id String?
  rating        Int
  comment       String?
  created_at    DateTime @default(now())

  order      Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id])
  @@index([user_id])
}

/** Story d'offre d'un commerce (style Instagram) : image ou vidÃ©o + texte optionnel. */
model Story {
  id                  String     @id @default(uuid())
  restaurant_id       String
  media_url           String
  media_type          StoryMedia
  /** LÃ©gende affichÃ©e sur le mÃ©dia (emojis inclus). */
  text                String?
  /** Couleur du texte (hex #RRGGBB), null = blanc. */
  text_color          String?
  /** Position du texte en fractions d'Ã©cran centrÃ©es (-0.5..0.5), null = bas centrÃ©. */
  text_x              Float?
  text_y              Float?
  /** Ã‰chelle du texte (0.5..3), null = 1. */
  text_scale          Float?
  /** Fin de diffusion (null = sans limite). */
  expires_at          DateTime?
  is_active           Boolean    @default(true)
  created_by_admin_id String?
  created_at          DateTime   @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([expires_at])
}
